{
  "version": 1,
  "about": "Register des Leitstands: Knoten, Verbindungen und Prüfungen. Der Scan (scan.mjs) führt die Prüfungen aus und schreibt www/data/leitstand.json. Keine Geheimnisse hier eintragen; envset prüft nur, ob ein Wert gesetzt ist.",
  "system": [
    "container",
    "backup",
    "cronhttp",
    "endpoints",
    "fnsync",
    "rls",
    "perms",
    "tls",
    "caddy",
    "disk",
    "hook",
    "reboot"
  ],
  "checks": {
    "container": {
      "type": "docker",
      "label": "Container",
      "hint": "docker ps -a prüfen, Logs des betroffenen Dienstes lesen (docker logs --tail 50 <name>), dann gezielt neu starten."
    },
    "backup": {
      "type": "backup",
      "label": "Backup",
      "dir": "/opt/nestua/backups/logs",
      "maxAgeHours": 26,
      "hint": "Log in /opt/nestua/backups/logs/ lesen; healthchecks.io zeigt den Fehler ebenfalls. Bei Bedarf von Hand starten: /opt/nestua/backup.sh"
    },
    "cronhttp": {
      "type": "cronhttp",
      "label": "Cron",
      "hours": 3,
      "hint": "Antworten in net._http_response und Logs der Edge Functions prüfen; Schlüssel kommen aus dem Vault-Secret service_role_key."
    },
    "endpoints": {
      "type": "http",
      "label": "Endpunkte",
      "targets": [
        {
          "url": "https://staging.nestua.de/",
          "expect": [
            200
          ]
        },
        {
          "url": "https://api-staging.nestua.de/rest/v1/",
          "expect": [
            401
          ]
        },
        {
          "url": "https://studio.nestua.de/",
          "expect": [
            401
          ]
        },
        {
          "url": "https://leitstand.nestua.de/",
          "expect": [
            401
          ]
        }
      ],
      "hint": "Caddy (systemctl status caddy) und den betroffenen Dienst prüfen."
    },
    "fnsync": {
      "type": "fnsync",
      "label": "Functions",
      "repo": "/opt/nestua/werkstatt/supabase/functions",
      "live": "/opt/nestua/staging/supabase-project/volumes/functions",
      "hint": "Abweichung mit tools/deploy-functions.sh <name> --dry-run ansehen; Live-Änderungen zuerst ins Repo holen."
    },
    "rls": {
      "type": "rls",
      "label": "RLS",
      "hint": "Neue Tabelle ohne RLS oder anon-Rechte: Migration prüfen, RLS einschalten, Policies ergänzen (nur nach OK)."
    },
    "perms": {
      "type": "perms",
      "label": "Datei-Rechte",
      "noOtherRead": [
        "/opt/nestua/staging/supabase-project/.env",
        "/opt/nestua/backup.env",
        "/opt/nestua/produktion/.env",
        "/opt/nestua/ops/notify.env"
      ],
      "noOtherWriteDir": "/opt/nestua/staging/supabase-project/volumes/functions",
      "hint": "Rechte zurücksetzen (Geheimnis-Dateien 640 root:nestua bzw. 600, Function-Ordner 755)."
    },
    "tls": {
      "type": "tls",
      "label": "Zertifikate",
      "hosts": [
        "staging.nestua.de",
        "api-staging.nestua.de",
        "studio.nestua.de",
        "leitstand.nestua.de"
      ],
      "warnDays": 14,
      "hint": "Caddy erneuert selbst; sonst DNS und Erreichbarkeit von Port 80/443 prüfen."
    },
    "caddy": {
      "type": "same",
      "label": "Caddy",
      "a": "/etc/caddy/Caddyfile",
      "b": "/opt/nestua/ops/reference/Caddyfile",
      "hint": "Unterschied zwischen /etc/caddy/Caddyfile und der Referenzkopie ansehen; gewollte Änderung: Referenzkopie aktualisieren."
    },
    "disk": {
      "type": "disk",
      "label": "Platte",
      "warnPercent": 80,
      "hint": "Größte Verbraucher suchen, alte Docker-Images auflisten, nichts ohne OK löschen."
    },
    "hook": {
      "type": "envset",
      "label": "Hook",
      "file": "/opt/nestua/backup.env",
      "key": "HC_PING_URL",
      "missing": "warn",
      "hint": "HC_PING_URL in der Backup-Konfiguration eintragen (Nutzer)."
    },
    "reboot": {
      "type": "reboot",
      "label": "Neustart",
      "hint": "Neustart zu ruhiger Zeit planen (Nutzer, sudo shutdown -r <zeit>)."
    },
    "vault": {
      "type": "sql",
      "label": "Vault-Secret",
      "query": "select count(*) from vault.secrets where name = 'service_role_key'",
      "expect": "1",
      "hint": "Vault-Secret service_role_key fehlt: Cron-Jobs scheitern. Aus der Umgebung der Edge Functions neu anlegen (ohne Ausgabe)."
    },
    "notify": {
      "type": "envset",
      "label": "notify.env",
      "file": "/opt/nestua/ops/notify.env",
      "key": "DISCORD_WEBHOOK_SERVER",
      "missing": "bad",
      "hint": "DISCORD_WEBHOOK_SERVER in /opt/nestua/ops/notify.env eintragen (Nutzer): Discord, Kanal #server, Kanal bearbeiten, Integrationen, Webhooks."
    },
    "reports": {
      "type": "file",
      "label": "Berichte",
      "path": "/opt/nestua/ops/reports"
    },
    "srvcheck": {
      "type": "file",
      "label": "server-check.sh",
      "path": "/opt/nestua/ops/server-check.sh"
    },
    "srvskill": {
      "type": "file",
      "label": "Skill nestua-server-check",
      "path": "/opt/nestua/werkstatt/.claude/skills/nestua-server-check/SKILL.md"
    },
    "srvcron": {
      "type": "cron",
      "label": "Cron 06:00",
      "pattern": "server-check"
    },
    "restore": {
      "type": "file",
      "label": "restore-test.sh",
      "path": "/opt/nestua/ops/restore-test.sh"
    },
    "scancron": {
      "type": "cron",
      "label": "Scan alle 5 Minuten",
      "pattern": "leitstand/scan.mjs"
    },
    "lp_guard": {
      "type": "file",
      "label": "Wächter-Hook",
      "path": "/opt/nestua/werkstatt/.claude/hooks/guard-secrets.py"
    },
    "lp_user": {
      "type": "contains",
      "label": "Server-Einstellungen",
      "path": "/home/nestua/.claude/settings.json",
      "text": "guard-secrets.py",
      "what": "den Wächter-Hook"
    },
    "lp_project": {
      "type": "contains",
      "label": "Projekt-Einstellungen",
      "path": "/opt/nestua/werkstatt/.claude/settings.json",
      "text": "guard-secrets.py",
      "what": "den Wächter-Hook"
    },
    "lp_start": {
      "type": "contains",
      "label": "Start-Hook",
      "path": "/home/nestua/.claude/settings.json",
      "text": "session-status.py",
      "what": "den Start-Hook"
    },
    "lp_deploy": {
      "type": "file",
      "label": "deploy-functions.sh",
      "path": "/opt/nestua/werkstatt/tools/deploy-functions.sh"
    },
    "lp_sudo": {
      "type": "file",
      "label": "sudo-Freigabe (Vorlage)",
      "path": "/opt/nestua/ops/reference/sudoers-nestua-ops"
    },
    "notify_kontext": {
      "type": "envset",
      "label": "Discord #kontext",
      "file": "/opt/nestua/ops/notify.env",
      "key": "DISCORD_WEBHOOK_KONTEXT",
      "missing": "warn",
      "hint": "DISCORD_WEBHOOK_KONTEXT in der Meldungs-Konfiguration eintragen (Nutzer): Discord, Kanal bearbeiten, Integrationen, Webhooks."
    },
    "notify_pruefer": {
      "type": "envset",
      "label": "Discord #pruefer",
      "file": "/opt/nestua/ops/notify.env",
      "key": "DISCORD_WEBHOOK_PRUEFER",
      "missing": "warn",
      "hint": "DISCORD_WEBHOOK_PRUEFER in der Meldungs-Konfiguration eintragen (Nutzer): Discord, Kanal bearbeiten, Integrationen, Webhooks."
    },
    "notify_dsgvo": {
      "type": "envset",
      "label": "Discord #datenschutz",
      "file": "/opt/nestua/ops/notify.env",
      "key": "DISCORD_WEBHOOK_DSGVO",
      "missing": "warn",
      "hint": "DISCORD_WEBHOOK_DSGVO in der Meldungs-Konfiguration eintragen (Nutzer): Discord, Kanal bearbeiten, Integrationen, Webhooks."
    },
    "notify_social": {
      "type": "envset",
      "label": "Discord #social",
      "file": "/opt/nestua/ops/notify.env",
      "key": "DISCORD_WEBHOOK_SOCIAL",
      "missing": "warn",
      "hint": "DISCORD_WEBHOOK_SOCIAL in der Meldungs-Konfiguration eintragen (Nutzer): Discord, Kanal bearbeiten, Integrationen, Webhooks."
    },
    "kctx_skript": {
      "type": "file",
      "label": "kontext-cron.sh",
      "path": "/opt/nestua/ops/agenten/kontext/kontext-cron.sh",
      "hint": "tools/agenten/kontext/deploy.sh ausführen."
    },
    "kctx_key": {
      "type": "file",
      "label": "Deploy-Key nestua-notes",
      "path": "/home/nestua/.ssh/github_notes_deploy.pub",
      "hint": "Schlüssel erzeugen (Nutzer) und in GitHub bei nestua-notes als Deploy-Key mit Schreibrecht eintragen."
    },
    "kctx_vault": {
      "type": "file",
      "label": "Vault-Klon",
      "path": "/opt/nestua/ops/vault/.git",
      "hint": "git clone git@github-notes:appworkshopdb/nestua-notes.git /opt/nestua/ops/vault"
    },
    "kctx_cron": {
      "type": "cron",
      "label": "Cron Mo 07:00",
      "pattern": "kontext-cron",
      "hint": "Cron-Eintrag montags 07:00 ergänzen (nach OK des Nutzers)."
    },
    "kctx_repo": {
      "type": "file",
      "label": "MyHome-Repo",
      "path": "/opt/nestua/werkstatt/.git"
    },
    "pr_workflow": {
      "type": "file",
      "label": "Workflow Prüfer",
      "path": "/opt/nestua/werkstatt/.github/workflows/pruefer.yml",
      "hint": "Workflow liegt im Repo; Branch-Schutzregel für main mit Pflicht-Check \"Regel-Check\" setzt der Nutzer in GitHub."
    },
    "pr_skript": {
      "type": "file",
      "label": "pruefer-cron.sh",
      "path": "/opt/nestua/ops/agenten/pruefer/pruefer-cron.sh",
      "hint": "tools/agenten/pruefer/deploy.sh ausführen."
    },
    "pr_repo": {
      "type": "file",
      "label": "PR-Stände (Bare-Repo)",
      "path": "/opt/nestua/ops/pruefer/MyHome.git/HEAD",
      "hint": "/opt/nestua/ops/agenten/pruefer/pruefer-cron.sh --seed legt es an."
    },
    "pr_cron": {
      "type": "cron",
      "label": "Cron alle 15 Min",
      "pattern": "pruefer-cron",
      "hint": "Cron-Eintrag */15 ergänzen (nach OK des Nutzers)."
    }
  },
